# Set strong, unique, URL-safe random values (e.g. openssl rand -hex 32).
# These must never be committed with populated values.
POSTGRES_USER=fastify
POSTGRES_PASSWORD=
API_KEY=
# DATABASE_URL is for running Node locally outside Docker Compose.
# Compose constructs the internal database URL using POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://fastify:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:5432/fastify_concept
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
ENABLE_DOCS=false
